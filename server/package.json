{
  "name": "@bookstorebd/server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB REST API and Socket.IO gateway for BookStoreBD",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "nodemon --ext ts,json --exec \"tsx index.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "migrate:images": "tsx scripts/migrateImages.ts",
    "migrate:images:dry": "tsx scripts/migrateImages.ts --dry-run",
    "gmail:token": "tsx scripts/gmailToken.ts",
    "encrypt:existing": "tsx scripts/encryptExisting.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UtshaBasak/BookStoreBD.git",
    "directory": "server"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "socket.io",
    "rest-api",
    "bookstore"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UtshaBasak/BookStoreBD/issues"
  },
  "homepage": "https://github.com/UtshaBasak/BookStoreBD#readme",
  "dependencies": {
    "@sentry/node": "^11.5.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.16",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
