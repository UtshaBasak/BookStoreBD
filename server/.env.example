# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas or local).
MONGO=mongodb://127.0.0.1:27017/bookstorebd

# HTTP port the API listens on.
PORT=4000

# development | production
NODE_ENV=development

# --- Authentication -------------------------------------------------------
# Secret used to sign access tokens. Must be at least 32 characters; the
# server refuses to start otherwise. Generate one with:
#   openssl rand -hex 48
# Rotating this value signs everyone out.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# How long an ACCESS token stays valid. Deliberately short: it cannot be
# revoked, so the window in which a stolen one is useful should be small.
JWT_EXPIRES_IN=15m

# How long a refresh token stays valid. This is what keeps a session alive,
# and unlike the access token it can be revoked.
REFRESH_TOKEN_TTL_DAYS=30

# Cookie flags for the refresh token. Secure defaults to on in production.
COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# Serve the built client from the API process, making the app same-origin.
# Defaults to on in production.
SERVE_CLIENT=

# Only for a cross-origin deployment, where the client is served from a
# different host than the API. Added to the Content-Security-Policy so the
# browser is allowed to call the API at all; leave blank when same-origin.
CLIENT_API_ORIGIN=

# Comma-separated e-mails promoted to administrator on their next sign-in.
ADMIN_EMAILS=

# Comma-separated list of browser origins allowed to call the API.
# Add the deployed client origin here, with no trailing slash.
CORS_ORIGINS=http://localhost:5173

# SMTP credentials used for OTP e-mails.
# For Gmail use an App Password, not your account password.
SMTP_SERVICE=gmail
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password

# Gmail's web API, over HTTPS - needed where the SMTP ports are blocked, as
# on Render's free plan. Used instead of SMTP_PASS when all three are set;
# mail still comes from SMTP_USER. The client is a Google Cloud OAuth client
# of type "Desktop app"; the refresh token comes from `npm run gmail:token`,
# which writes it here.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Password given to the demo accounts created by `npm run seed`.
SEED_PASSWORD=Password123!

# --- Image hosting (optional) -----------------------------------------------
# With these unset, book covers are stored as base64 on the document, as
# before. Set them to upload straight from the browser to Cloudinary instead.
# Find them at cloudinary.com -> Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Secret. Treat it like JWT_SECRET: never commit it.
CLOUDINARY_API_SECRET=

# --- Search engines ---------------------------------------------------------
# The canonical origin, used for the absolute URLs in robots.txt and
# sitemap.xml. Left blank, the origin of the request is used, which is right
# until the site answers on more than one hostname. Set it at launch.
PUBLIC_SITE_URL=

# --- Observability ----------------------------------------------------------
# trace | debug | info | warn | error | fatal | silent
# Defaults to debug in development, info in production, silent under test.
LOG_LEVEL=

# Optional. Error reporting stays off entirely when this is unset.
SENTRY_DSN=
# Fraction of transactions traced, 0 to 1. Errors are reported regardless.
SENTRY_TRACES_SAMPLE_RATE=0

# Upload limits (optional; defaults shown).
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_FILES=10

# --- Returns ----------------------------------------------------------------
# Where an approved return is sent, quoted in the e-mail that approves it.
# Left blank, the e-mail asks the buyer to reply so the courier can be arranged.
RETURN_ADDRESS=

# --- Passwords --------------------------------------------------------------
# New passwords are checked against Have I Been Pwned's breached-password list
# (only the first five characters of the password's SHA-1 leave the server).
# Set to "off" to skip the check; it is always off under test.
PASSWORD_BREACH_CHECK=
