# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas or local).
MONGO=mongodb://127.0.0.1:27017/bookstorebd

# HTTP port the API listens on.
PORT=4000

# development | production
NODE_ENV=development

# --- Authentication -------------------------------------------------------
# Secret used to sign access tokens. Must be at least 32 characters; the
# server refuses to start otherwise. Generate one with:
#   openssl rand -hex 48
# Rotating this value signs everyone out.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# How long an access token stays valid (zeit/ms format).
JWT_EXPIRES_IN=7d

# Comma-separated e-mails promoted to administrator on their next sign-in.
ADMIN_EMAILS=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://bookstorebd.vercel.app

# SMTP credentials used for OTP e-mails.
# For Gmail use an App Password, not your account password.
SMTP_SERVICE=gmail
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password

# Upload limits (optional; defaults shown).
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_FILES=10
