# Settings for `docker compose`. Copy this file to `.env` in the same folder
# and fill it in; Compose reads `.env` automatically, and git ignores it.

# Signs access tokens. Required. Generate one with: openssl rand -hex 48
JWT_SECRET=

# Password for the demo accounts that `docker compose run --rm seed` creates.
# Required to seed; choose your own.
SEED_PASSWORD=

# Optional. Comma-separated addresses made administrator when they sign in.
# The seeded admin account is an administrator already.
ADMIN_EMAILS=

# Optional: image hosting (cloudinary.com -> Settings -> API Keys). Without
# these, book covers are stored in the database.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: the bot check on sign-in (Cloudflare Turnstile) and "Continue with
# Google". See server/.env.example for where each comes from.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: e-mail for sign-up codes and order updates (a Gmail App Password).
SMTP_USER=
SMTP_PASS=
