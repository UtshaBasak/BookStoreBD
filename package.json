{
  "name": "mern-bookstore",
  "version": "1.0.0",
  "private": true,
  "description": "BookStoreBD - a MERN marketplace for new and second-hand books, with role-based access, order tracking and real-time buyer-seller chat.",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "install:all": "npm --prefix client install && npm --prefix server install",
    "dev": "concurrently --names \"SERVER,CLIENT\" --prefix-colors \"cyan,magenta\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "start": "npm --prefix server start",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "preview": "npm --prefix client run preview",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck",
    "typecheck:client": "npm --prefix client run typecheck",
    "typecheck:server": "npm --prefix server run typecheck",
    "lint": "npm --prefix client run lint && npm --prefix server run lint",
    "lint:client": "npm --prefix client run lint",
    "lint:server": "npm --prefix server run lint",
    "test": "npm --prefix server run test && npm --prefix client run test",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UtshaBasak/MernBookstore.git"
  },
  "keywords": [
    "mern",
    "react",
    "express",
    "mongodb",
    "socket.io",
    "bookstore",
    "e-commerce"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UtshaBasak/MernBookstore/issues"
  },
  "homepage": "https://github.com/UtshaBasak/MernBookstore#readme",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
