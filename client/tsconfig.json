{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    // Vite resolves and bundles, so the compiler only ever type-checks here.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Imports must say whether they are types. Type-only imports are erased
    // before anything tries to resolve them, which is what lets the client
    // compile against the shared contract without bundling it.
    "verbatimModuleSyntax": true,

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": ["vite/client", "node"],

    "paths": {
      // The API owns the wire contract; this compiles against the same file
      // the server does, so a response shape cannot drift on one side alone.
      "@shared/*": ["../server/shared/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
