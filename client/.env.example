# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed. Never commit `.env`.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the BookStoreBD API.
#
# Leave it EMPTY for same-origin, which is the intended setup: the Vite dev
# server proxies the API prefixes to the backend, so the browser sees one
# origin and the refresh cookie is first-party. Production works the same way,
# through nginx, so development matches it.
#
# Only set this when the client is deployed somewhere the API is not, e.g.
# VITE_API_URL=https://bookstorebd.onrender.com
# The refresh cookie will not survive that, so sessions end when the access
# token expires.
VITE_API_URL=

# Where the dev-server proxy forwards API requests. Change this if the backend
# is not on the default port.
VITE_PROXY_TARGET=http://localhost:4000
